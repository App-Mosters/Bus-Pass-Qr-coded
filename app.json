{
  "expo": {
    "name": "Bus Pass QR",
    "slug": "bus-pass-qr",
    "version": "1.0.0",
    "plugins": [
     "./plugins/withJscVersionFix.js",
     [
       "expo-build-properties",
       {
         "android": {
           "targetSdkVersion": 34,
           "compileSdkVersion": 34
         }
       }
     ]
   ],
    "android": {
      "package": "com.appmosters.buspassqr",
      "permissions": [
        "CAMERA"
      ],
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "ios": {
      "bundleIdentifier": "com.appmosters.buspassqr",
      "jsEngine": "hermes",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is needed to scan bus pass QR codes."
      }
    },
    "extra": {
      "eas": {
        "projectId": "7403a56f-4771-4005-92cc-259cb6ccea3c"
      }
    },
    "owner": "mubashir_4" 
  }
}
